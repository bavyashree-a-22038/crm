# Zoho server-based application credentials
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Set these for the Zoho data center where the client is registered.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CRM_API_URL=https://www.zohoapis.com

# Requested now so later phases do not require reauthorization.
ZOHO_OAUTH_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.READ,ZohoCRM.coql.READ,ZohoSearch.securesearch.READ

# Use a random value of at least 32 characters outside local development.
SESSION_SECRET=

# Catalyst Data Store table used by AppSail production sessions.
CATALYST_SESSION_TABLE=MiniCrmSessions

PORT=3000
NODE_ENV=development
TRUST_PROXY=false
